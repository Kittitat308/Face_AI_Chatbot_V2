DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/face_ai_chatbot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CAMERA_INDEX=0
APP_NAME=Face AI Chatbot

# Face security and scan cadence
FACE_MATCH_THRESHOLD=0.45
LOGIN_SCAN_INTERVAL_MS=5000
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=5

# Speech
WHISPER_RECORD_SECONDS=6
